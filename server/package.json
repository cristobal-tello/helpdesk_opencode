    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^6.0.2",
    "bun-types": "^1.4.2",
    "prisma": "^6.9.0",
    "typescript": "^5.8.0"
